{
  "name": "@quicio/espiral",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Espiral — instrumento generativo de ritmos, escalas y automatización.",
  "scripts": {
    "dev": "vite",
    "dev:modular": "VITE_ENGINE=modular vite",
    "dev:tone": "VITE_ENGINE=tone vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:audio": "node scripts/audio-check.mjs"
  },
  "dependencies": {
    "@quicio/umbral-tone": "github:quicio/umbral-tone#v0.1.0",
    "tone": "^14.7.77"
  },
  "devDependencies": {
    "playwright": "^1.65.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "generative-music",
    "tonejs",
    "instrument",
    "sequencer",
    "web-audio"
  ],
  "license": "MIT",
  "author": "Quicio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quicio/espiral.git"
  },
  "homepage": "https://quicio.github.io/espiral/",
  "engines": {
    "node": ">=18"
  }
}
